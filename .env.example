# Copy this file to .env and fill in your values. Do not commit .env (it is in .gitignore).
# Local development only; on PythonAnywhere use the WSGI file for POSaBit vars.

# POSaBit API (optional – for products and manifest)
# Use either POSABIT_API_TOKEN or POSABIT_ORDER_PAD_TOKEN (Order Pad = Settings > Integrations in app.posabit.com)
POSABIT_ORDER_PAD_TOKEN=Bpviz-LE9TV_nK9Ks7vZzw

# Default menu feed key (current single-store setup)
POSABIT_MENU_FEED_KEY=8965dc69-d3aa-439c-877d-c5c407b0f1dc

# Optional: per-venue menu feed keys (fill in as needed).
# These are reserved for the store/venue switcher so you have a place
# to paste keys for each store. Names are just examples – change them
# to match your actual POSaBit venue names.
# POSABIT_MENU_FEED_KEY_BOTHELL=your_bothell_feed_key_here
# POSABIT_MENU_FEED_KEY_SEATTLE=your_seattle_feed_key_here
# POSABIT_MENU_FEED_KEY_BURIEN=your_burien_feed_key_here
# POSABIT_MENU_FEED_KEY_LYNNWOOD=your_lynnwood_feed_key_here

# If menu feed returns 401, use venue inventories (same token, no feed key):
POSABIT_USE_VENUE_INVENTORIES=1
# Optional: set to 1 to include products with 0 quantity (default: only quantity > 0)
# POSABIT_VENUE_INVENTORY_INCLUDE_ZERO_QUANTITY=1
POSABIT_API_BASE_URL=https://app.posabit.com/api
USE_POSABIT_PRODUCTS=true