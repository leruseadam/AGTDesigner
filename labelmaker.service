[Unit]
Description=AGT Label Maker Flask Application
After=network.target

[Service]
Type=simple
User=adamcordova
WorkingDirectory=/Users/adamcordova/Desktop/labelMaker_ QR copy final
ExecStart=/usr/local/bin/python app.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=FLASK_ENV=production
Environment=FLASK_PORT=8001

# Process management
PIDFile=/tmp/labelmaker_app.pid
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
